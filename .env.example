# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Modelo de lenguaje ───────────────────────────────────────────────────────
# Clave de la API de Anthropic. Se usa SOLO desde rutas de servidor.
# Nunca le pongas el prefijo NEXT_PUBLIC_: quedaría expuesta en el navegador.
ANTHROPIC_API_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Proyecto en región Americas (datos financieros personales).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: salta las políticas de seguridad de la base de datos.
# La usan las rutas de servidor para escribir la entrevista del cliente.
# SOLO SERVIDOR. Si esta clave lleva prefijo NEXT_PUBLIC_, cualquiera con el
# navegador abierto tiene acceso completo a la base de datos.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Vigilancia de mercado (Fase 11) ──────────────────────────────────────────
# Clave de Resend. SOLO SERVIDOR — igual que ANTHROPIC_API_KEY.
RESEND_API_KEY=
# Remitente verificado en Resend. Sin dominio propio verificado, usa el de
# pruebas de Resend (onboarding@resend.dev) — solo te llegará a ti mismo.
RESEND_REMITENTE_ALERTAS=onboarding@resend.dev
# Correo de la asesora que recibe la alerta de cada cliente.
EMAIL_ASESORA_ALERTAS=
# Secreto compartido con Vercel Cron para autorizar la llamada a
# /api/cron/vigilancia-mercado. Genera uno cualquiera (ej. `openssl rand -hex 32`)
# y configúralo también como variable de entorno del proyecto en Vercel.
CRON_SECRET=

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# Credenciales que consumen los servidores declarados en .mcp.json.
# En .mcp.json van referenciadas como ${VARIABLE}; el valor real vive aquí.
# SUPABASE_ACCESS_TOKEN=
